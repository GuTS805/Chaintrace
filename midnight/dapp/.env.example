# Midnight network: preview (default) or preprod.
VITE_NETWORK_ID=preview
# Used for reviewer verification without a wallet, and as a fallback.
VITE_INDEXER_URI=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URI=wss://indexer.preview.midnight.network/api/v4/graphql/ws
# Local proof server (npm run proof-server). Used if the wallet does not supply one.
VITE_PROOF_SERVER_URI=http://localhost:6300
