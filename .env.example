# ---- Database ----
# Async driver (app runtime). Alembic derives a sync URL from this automatically.
DATABASE_URL=postgresql+asyncpg://vasp:vasp@localhost:5432/vasp

# ---- Cache ----
REDIS_URL=redis://localhost:6379/0

# ---- Chain data providers (Phase 3+; unused while running offline fixtures) ----
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/api
RPC_URL=

# ---- Attribution engine ----
# Bundled model artifact identifier; surfaced in every AttributionResult.
MODEL_VERSION=phase1-dev
# Below this max candidate probability the engine returns insufficient_evidence.
CONFIDENCE_THRESHOLD=0.55

# ---- App ----
LOG_LEVEL=INFO
ENV=development
