# ---- Database ----
# Async driver (app runtime). Alembic derives a sync URL from this automatically.
DATABASE_URL=postgresql+asyncpg://vasp:vasp@localhost:5432/vasp

# ---- Cache ----
REDIS_URL=redis://localhost:6379/0

# ---- Chain data providers ----
# Etherscan: optional keyed live path, not required (Blockscout below is the
# keyless path the "trace any wallet" feature actually uses).
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/api
RPC_URL=
# Keyless Etherscan-compatible endpoints — no API key needed for any of these.
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com/api
POLYGON_BLOCKSCOUT_BASE_URL=https://polygon.blockscout.com/api
TRONGRID_BASE_URL=https://api.trongrid.io
# Retry + circuit breaker around every provider call (see app/providers/resilience.py).
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_DELAY=0.5
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30.0

# ---- Attribution engine ----
# Bundled model artifact identifier; surfaced in every AttributionResult.
MODEL_VERSION=phase1-dev
# Below this max candidate probability the engine returns insufficient_evidence.
CONFIDENCE_THRESHOLD=0.55

# ---- Traversal bounds (every traversal is bounded — HARD REQUIREMENT #5) ----
# Defaults used when a caller doesn't specify (ContextBuilder, i.e. every
# /attribution and /risk request); ceilings are the absolute server-side cap
# no request — via /graph's max_nodes query param or otherwise — can exceed.
TRAVERSAL_MAX_NODES=2000
TRAVERSAL_MAX_NODES_CEILING=10000
TRAVERSAL_MAX_HOPS=6
TRAVERSAL_MAX_HOPS_CEILING=8
TRAVERSAL_MIN_VALUE_WEI=0
TRAVERSAL_TIMEOUT_SECONDS=20.0

# ---- Auth (officer login) ----
# Demo default below is fine for the offline demo (single machine, no real case
# data). The app refuses to start with this default when ENV=production.
JWT_SECRET=chaintrace-demo-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Login brute-force throttling (cooldown, not a permanent lockout).
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900.0
LOGIN_COOLDOWN_SECONDS=60.0

# ---- Request limits ----
# No file uploads anywhere in this API — this is a DoS guard, not a real
# usage constraint.
MAX_REQUEST_BODY_BYTES=2000000

# ---- App ----
LOG_LEVEL=INFO
ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
