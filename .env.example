# ---- Database ----
# Async driver (app runtime). Alembic derives a sync URL from this automatically.
DATABASE_URL=postgresql+asyncpg://vasp:vasp@localhost:5432/vasp

# ---- Cache ----
REDIS_URL=redis://localhost:6379/0

# ---- Chain data providers (unused while running offline fixtures) ----
# Failover order, most-preferred first. Providers whose credentials are missing
# are skipped when the router is built, so it is safe to list all of them.
PROVIDER_ORDER=etherscan,blockscout,alchemy,infura

# Indexing providers -- these can answer address transaction history.
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/api
ALCHEMY_API_KEY=
ALCHEMY_BASE_URL=https://eth-mainnet.g.alchemy.com/v2

# Blockscout needs no key. It is therefore opt-in: without this flag an offline
# run would silently acquire a live network dependency.
PROVIDER_ALLOW_KEYLESS=false
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com/api

# Infura is a plain JSON-RPC node: balance/nonce/code only. It has no address
# index, so it is never asked for transaction history.
INFURA_API_KEY=
INFURA_BASE_URL=https://mainnet.infura.io/v3
RPC_URL=

# ---- Provider resilience ----
PROVIDER_TIMEOUT=15
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_RECOVERY_SECONDS=30
PROVIDER_PAGE_SIZE=200

# ---- Provider cache (Redis) ----
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_TTL_SECONDS=900

# ---- Attribution engine ----
# Bundled model artifact identifier; surfaced in every AttributionResult.
MODEL_VERSION=phase1-dev
# Below this max candidate probability the engine returns insufficient_evidence.
CONFIDENCE_THRESHOLD=0.55

# ---- App ----
LOG_LEVEL=INFO
ENV=development
